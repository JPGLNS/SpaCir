# Ignore all root-level files and directories by default
/*

# Keep repository documentation and configuration
!/.gitignore
!/README.md
!/requirements.txt

# Keep analysis scripts
!/scripts/

# Keep only the example configuration
!/config/
/config/*
!/config/samples.example.tsv

# Python cache
**/__pycache__/
*.py[cod]

# Temporary and log files
*.log
*.tmp
*.temp
*.swp
*~

# OS and editor files
.DS_Store
.vscode/
.idea/
